#set page(
  paper: "a4",
  margin: (x: 1.4cm, top: 1.4cm, bottom: 1.4cm),
  header: context {
    if counter(page).get().first() > 1 [
      #grid(
        columns: (1fr, auto),
        align(left)[#text(size: 8.5pt, fill: rgb("#475569"))[光衡 (GH-VI-2026) · 答辩终极攻防白皮书：评委三十大刁钻质询与绝杀反击手册]],
        align(right)[#text(size: 8.5pt, fill: rgb("#475569"))[第 42 届全国青创赛 · 第 #counter(page).display() 页]]
      )
      #v(-2pt)
      #line(length: 100%, stroke: 0.5pt + rgb("#cbd5e1"))
    ]
  },
  footer: [
    #line(length: 100%, stroke: 0.5pt + rgb("#cbd5e1"))
    #v(-2pt)
    #grid(
      columns: (1fr, auto),
      align(left)[#text(size: 8pt, fill: rgb("#64748b"))[CASTIC 2026 · 赛前高压抗辩特训内部密卷 (作者：林诚俊)]],
      align(right)[#text(size: 8.5pt, weight: "bold", fill: rgb("#0f172a"))[#context counter(page).display("1 / 1", both: true)]]
    )
  ]
)

#set text(
  font: ("Microsoft YaHei", "WenQuanYi Micro Hei", "SimSun"),
  size: 9.0pt,
  fill: rgb("#0f172a"),
  lang: "zh"
)

#set par(
  leading: 0.6em,
  justify: true
)

// 样式定义
#let section-title(num, title, subtitle) = {
  v(8pt)
  rect(
    width: 100%,
    fill: rgb("#0f172a"),
    radius: 3pt,
    inset: (x: 10pt, y: 7pt)
  )[
    #text(size: 11pt, weight: "bold", fill: white)[#num. #title]
    #h(8pt)
    #text(size: 8pt, fill: rgb("#94a3b8"))[#subtitle]
  ]
  v(4pt)
}

#let qa-card(id, question, strategy, answer, evidence) = {
  v(4pt)
  rect(
    width: 100%,
    fill: rgb("#ffffff"),
    stroke: 0.8pt + rgb("#cbd5e1"),
    radius: 3pt,
    inset: (x: 9pt, y: 7pt)
  )[
    // 提问栏
    #rect(
      width: 100%,
      fill: rgb("#fef2f2"),
      stroke: 0.5pt + rgb("#fecaca"),
      radius: 2pt,
      inset: (x: 6pt, y: 4pt)
    )[
      #text(weight: "bold", fill: rgb("#b91c1c"))[#id 评委刁难质询：]
      #text(weight: "bold", fill: rgb("#7f1d1d"))[#question]
    ]
    #v(3pt)
    // 破局点
    #text(size: 8.2pt, weight: "bold", fill: rgb("#0369a1"))[【破局策略】]
    #text(size: 8.2pt, fill: rgb("#0c4a6e"))[#strategy]     #v(2pt)
    // 标准答辩说辞
    #text(size: 8.8pt, weight: "bold", fill: rgb("#047857"))[【答辩现场满分应答应付词（直接背诵）】]     #rect(
      fill: rgb("#f0fdf4"),
      stroke: (left: 2.5pt + rgb("#16a34a"), rest: 0.3pt + rgb("#bbf7d0")),
      inset: (x: 7pt, y: 5pt),
      width: 100%
    )[
      #text(size: 8.5pt, fill: rgb("#14532d"))[#answer]
    ]
    #v(2pt)
    // 支撑证据
    #text(size: 7.8pt, fill: rgb("#64748b"))[*硬核工程依据/国标标准*：#evidence]
  ]
  v(3pt)
}

// 封面题头
#align(center)[
  #text(size: 15pt, weight: "black", fill: rgb("#0f172a"))[
    光衡 (GH-VI-2026) · 国赛答辩终极攻防白皮书
  ]   #v(2pt)
  #text(size: 10.5pt, weight: "bold", fill: rgb("#0284c7"))[
    评审委员会三十大刁钻挑刺追问与绝杀级满分应对全景手册
  ]   #v(2pt)
  #text(size: 8pt, fill: rgb("#475569"))[
    面向第 42 届全国青少年科技创新大赛 (CASTIC) · 瑞安市赛 / 温州市赛 / 浙江省赛 / 国赛通用备考密卷
  ]
]

#v(2pt)
#rect(fill: rgb("#f8fafc"), stroke: 0.5pt + rgb("#e2e8f0"), radius: 3pt, inset: 7pt, width: 100%)[
  #text(size: 8.2pt, fill: rgb("#334155"))[
    *使用说明（海鸥教练令）*：评委进场提问不是和你唠家常，他们的提问本质上是*压力测试（Stress Test）*。评委问出尖锐问题往往意味着项目已经引起了他们的极大兴趣。本手册汇集了机械、光学、AI、空间建筑、实验真实性与“三自原则”六大维度的 30 处最致命漏洞，按“破局策略 + 标准第一人称答辩词 + 国标公式依据”三位一体打造。牢记核心法则：*永远不要辩解说自己做不到，而是用工程分级、设计余量与标准规范把质疑转化为展现深度思考的加分项！*
  ]
