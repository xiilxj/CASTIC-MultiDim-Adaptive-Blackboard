#set page(
  paper: "a4",
  margin: (x: 1.35cm, top: 1.35cm, bottom: 1.35cm),
  header: context {
    if counter(page).get().first() > 1 [
      #grid(
        columns: (1fr, auto),
        align(left)[#text(size: 8.5pt, fill: rgb("#334155"))[光衡 (GH-VI-2026) · 关键技术质询与工程论证专家答疑报告]],
        align(right)[#text(size: 8.5pt, fill: rgb("#475569"))[第 42 届全国青创赛 · 评审专家审阅资料 · 第 #counter(page).display() 页]]
      )
      #v(-2pt)
      #line(length: 100%, stroke: 0.5pt + rgb("#cbd5e1"))
    ]
  },
  footer: [
    #line(length: 100%, stroke: 0.5pt + rgb("#cbd5e1"))
    #v(-2pt)
    #grid(
      columns: (1fr, auto),
      align(left)[#text(size: 8pt, fill: rgb("#64748b"))[CASTIC 2026 科技创新成果项目专项答疑报告 · 项目负责人：林诚俊]],
      align(right)[#text(size: 8.5pt, weight: "bold", fill: rgb("#0f172a"))[#context counter(page).display("1 / 1", both: true)]]
    )
  ]
)

#set text(
  font: ("Microsoft YaHei", "WenQuanYi Micro Hei", "SimSun"),
  size: 8.8pt,
  fill: rgb("#0f172a"),
  lang: "zh"
)

#set par(
  leading: 0.55em,
  justify: true
)

// 章节标题样式
#let section-title(num, title, subtitle) = {
  v(7pt)
  rect(
    width: 100%,
    fill: rgb("#0f172a"),
    radius: 3pt,
    inset: (x: 10pt, y: 6pt)
  )[
    #text(size: 10.5pt, weight: "bold", fill: white)[#num. #title]
    #h(8pt)
    #text(size: 8pt, fill: rgb("#94a3b8"))[#subtitle]
  ]
  v(3pt)
}

// 专家质询与解答卡片样式
#let qa-card(id, title, concern, answer, evidence) = {
  v(4pt)
  rect(
    width: 100%,
    fill: rgb("#ffffff"),
    stroke: 0.6pt + rgb("#cbd5e1"),
    radius: 3pt,
    inset: (x: 9pt, y: 6pt)
  )[
    // 议题标题与专家质询要点
    #rect(
      width: 100%,
      fill: rgb("#f8fafc"),
      stroke: 0.4pt + rgb("#e2e8f0"),
      radius: 2pt,
      inset: (x: 6pt, y: 4.5pt)
    )[
      #text(weight: "bold", fill: rgb("#0369a1"))[【议题 #id：#title】] \
      #v(1pt)
      #text(size: 8.2pt, weight: "bold", fill: rgb("#b91c1c"))[专家质询关切：]
      #text(size: 8.2pt, fill: rgb("#334155"))[#concern]
    ]
    #v(3pt)
    // 项目组技术解答与工程论证
    #rect(
      fill: rgb("#ffffff"),
      stroke: (left: 2.5pt + rgb("#0284c7"), rest: 0.3pt + rgb("#e2e8f0")),
      inset: (x: 7pt, y: 5pt),
      width: 100%
    )[
      #text(size: 8.3pt, weight: "bold", fill: rgb("#0284c7"))[【技术解答与工程论证】] \
      #v(1pt)
      #text(size: 8.3pt, fill: rgb("#0f172a"))[#answer]
    ]
    #v(2pt)
    // 规范与证据支撑
    #text(size: 7.6pt, fill: rgb("#64748b"))[*设计依据与规范标准*：#evidence]
  ]
  v(2pt)
}

